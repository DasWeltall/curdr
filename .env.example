# Copy to .env, then replace with: python3 -c "import secrets; print(secrets.token_hex(32))"
CURDR_TOKEN=replace-with-a-random-token-at-least-24-characters
CURDR_AGENT_MODE=hermes
# setup:hermes selects your private LAN IP for Expo Go.
CURDR_BIND_HOST=127.0.0.1
CURDR_MODELS=openai/gpt-4.1-mini
CURDR_MAX_BUDGET=20
CURDR_MIN_INTERVAL=2
CURDR_ORIGINS=http://localhost:8000,http://localhost:8081,http://localhost:3000
CURDR_PROVIDER_URL=https://openrouter.ai/api/v1
# Required for live mode. Supply CURRENT upper-bound USD prices per 1M tokens.
# Example shape only, not actual prices:
# CURDR_MODEL_PRICES={"openai/gpt-4.1-mini":{"input":YOUR_PRICE,"output":YOUR_PRICE}}
CURDR_MODEL_PRICES={}
