{
  "name": "curdr",
  "version": "0.10.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web && node scripts/pwa.mjs",
    "avatar:build": "node scripts/build-avatar.mjs",
    "prestart": "node scripts/build-avatar.mjs",
    "go": "node scripts/expo-go.mjs",
    "go:tunnel": "node scripts/expo-go.mjs --tunnel ngrok",
    "prebuild:web": "node scripts/build-avatar.mjs",
    "setup:hermes": "python3 scripts/setup-hermes.py",
    "build:apk": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@expo-google-fonts/gabarito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
